# =============================================================================
# FC Learning Academy — Production & Local Environment Variables
# Copy to .env for local dev or configure in Vercel / Render / Cloud Run
# =============================================================================

# --- CORE SECURITY & PRODUCTION MODE ---
# Set DEMO_MODE="false" for clean Production (removes all 10 demo users & demo switcher).
DEMO_MODE="false"

# AUTH_SECRET: Required in production (>= 32 random hex chars) for HMAC-SHA256 session signing.
AUTH_SECRET=""

# BOOTSTRAP_ADMIN_*: Optional first official Super Admin auto-provisioned on clean production boot.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME="FC Academy Administrator"

# APP_URL: Public URL of your deployed site (e.g. https://fc-learning-academy.vercel.app)
APP_URL="http://localhost:3000"

# --- DATABASE: POSTGRESQL (SUPABASE / NEON — Option 1B) ---
DATABASE_URL=""

# --- STORAGE: CLOUDFLARE R2 (0 VND Egress — Option 2A) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="fc-learning-materials"
R2_PUBLIC_URL=""

# --- PAYMENTS: VIETQR (PAYOS), MOMO, VNPAY, STRIPE (Option 3A) ---
# Set PAYMENT_SANDBOX="false" in strict production once merchant credentials are active.
PAYMENT_SANDBOX="true"

# PayOS / VietQR (Instant 24/7 Vietnam bank transfer)
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""
VIETQR_BANK_BIN="970436"
VIETQR_ACCOUNT_NO=""
VIETQR_ACCOUNT_NAME="FC LEARNING ACADEMY"

# MoMo v2 E-Wallet (Future-ready HMAC-SHA256 IPN verified)
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"

# VNPay Domestic Gateway (HMAC-SHA512 IPN verified)
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""

# Stripe International Cards
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- GEMINI AI ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- OPTIONAL FIREBASE ADMIN ---
FIREBASE_SERVICE_ACCOUNT_JSON=""
