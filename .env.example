# =============================================================================
# FC Learning Academy — Environment Variables Template
# Copy to .env for local development or configure in Vercel / Cloud Run / Render
# =============================================================================

# AUTH_SECRET: Required in production (minimum 32 random hex chars) for HMAC-SHA256 session signing.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# DEMO_MODE: Set to "true" to allow Demo Sandbox 5-role quick switching in hosted demos.
# Set to "false" in strict enterprise production.
DEMO_MODE="true"

# DEFAULT_DEMO_PASSWORD: Optional default password for seeded demo accounts (defaults to FCAcademy@2026)
DEFAULT_DEMO_PASSWORD="FCAcademy@2026"

# GEMINI_API_KEY: Required for Gemini AI Tutor, Quiz Generator, OJT Pre-Audit, and GM Simulator AI.
GEMINI_API_KEY=""

# GEMINI_MODEL: Optional Gemini model ID override (defaults to gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: Public URL of your deployed site (e.g. https://fc-learning-academy.vercel.app)
APP_URL="http://localhost:3000"

# FIREBASE_SERVICE_ACCOUNT_JSON: Optional JSON string of a Firebase Admin service account
# for direct server-side BulkWriter/WriteBatch Firestore imports.
FIREBASE_SERVICE_ACCOUNT_JSON=""
